# Optional comma-separated browser origins for direct cross-origin API calls.
# Vite proxies /api and /health to localhost:8000 during local development.
TRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Required for AI-powered portrait analysis and image generation.
# Keep this key only in backend/.env; never put it in frontend configuration.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst